<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_receipts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ecc.telegram.receipts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting string="Cash-Outs Need a Receipt"
                         help="Session Review cannot be marked as reviewed while a cash-out has no Telegram receipt or a receipt paid by the cashier is not matched.">
                    <field name="pos_cash_out_receipt_required"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
