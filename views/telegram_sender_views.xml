<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecc_telegram_sender_list" model="ir.ui.view">
        <field name="name">ecc.telegram.sender.list</field>
        <field name="model">ecc.telegram.sender</field>
        <field name="arch" type="xml">
            <list editable="top" create="false">
                <field name="name"/>
                <field name="telegram_name"/>
                <field name="telegram_username"/>
                <field name="telegram_user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="receipt_count"/>
                <button name="action_view_receipts" type="object" string="Receipts" icon="fa-camera" class="btn-link"/>
                <field name="active" widget="boolean_toggle" string="Accepted"/>
            </list>
        </field>
    </record>
    <record id="view_ecc_telegram_sender_search" model="ir.ui.view">
        <field name="name">ecc.telegram.sender.search</field>
        <field name="model">ecc.telegram.sender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="telegram_username"/>
                <filter name="archived" string="Ignored" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_ecc_telegram_sender" model="ir.actions.act_window">
        <field name="name">Telegram Senders</field>
        <field name="res_model">ecc.telegram.sender</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No one sent a receipt yet</p>
            <p>A sender is added the first time someone posts a bill photo in the client's Telegram group.
               Rename it to the employee's name, or switch "Accepted" off to make the bot ignore that person.</p>
        </field>
    </record>
</odoo>
