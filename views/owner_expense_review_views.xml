<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Owner Expenses to Review: review list (decide on each line) -->
    <record id="view_ecc_owner_move_review_list" model="ir.ui.view">
        <field name="name">ecc.owner.move.review.list</field>
        <field name="model">ecc.owner.move</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false" decoration-muted="review_state != 'to_review'">
                <field name="date" readonly="1" widget="date"/>
                <field name="box_id" readonly="1" string="Cash Box"/>
                <field name="name" readonly="1" string="What"/>
                <field name="photo_count" readonly="1" string="Photos" optional="show"/>
                <field name="review_amount" readonly="1" sum="Total"/>
                <field name="review_as" readonly="review_state != 'to_review'" widget="selection_badge"/>
                <field name="category_id" readonly="review_state != 'to_review'" invisible="review_as != 'expense'"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="vendor_id" readonly="review_state != 'to_review'" invisible="review_as != 'vendor'"
                       placeholder="Which vendor?" options="{'no_create': True}"
                       context="{'res_partner_search_mode': 'supplier'}"/>
                <field name="review_state" widget="badge" optional="show"
                       decoration-warning="review_state == 'to_review'" decoration-success="review_state == 'reviewed'"
                       decoration-danger="review_state == 'rejected'"/>
                <button name="action_review_confirm" type="object" string="Confirm" icon="fa-check"
                        class="btn-link text-success" invisible="review_state != 'to_review'"/>
                <button name="action_review_reject" type="object" title="Reject" icon="fa-times"
                        class="btn-link text-danger" invisible="review_state != 'to_review'"
                        confirm="Not a business expense: it is removed and the amount goes back in his cash box."/>
                <button name="action_open_review" type="object" title="Open" icon="fa-external-link"
                        class="btn-link text-muted"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="expense_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Owner Expenses to Review: review form (photo next to the decision) -->
    <record id="view_ecc_owner_move_review_form" model="ir.ui.view">
        <field name="name">ecc.owner.move.review.form</field>
        <field name="model">ecc.owner.move</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" class="o_ecc_owner_review">
                <header>
                    <button name="action_review_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="review_state != 'to_review'"/>
                    <button name="action_review_reject" type="object" string="Reject"
                            invisible="review_state != 'to_review'"
                            confirm="Not a business expense: it is removed and the amount goes back in his cash box."/>
                    <field name="review_state" widget="statusbar" statusbar_visible="to_review,reviewed"/>
                </header>
                <sheet>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="flex-grow-1" style="min-width: 280px;">
                            <div class="text-muted small text-uppercase fw-bold">Paid by the owner</div>
                            <h1 class="mb-0"><field name="review_amount" readonly="1"/></h1>
                            <h3 class="text-muted fw-normal"><field name="name" readonly="1"/></h3>
                            <group class="mt-2">
                                <field name="box_id" readonly="1" string="Cash Box"/>
                                <field name="date" readonly="1"/>
                                <field name="source" readonly="1"/>
                            </group>

                            <div class="mt-3 p-3 border rounded-3" invisible="review_state != 'to_review'">
                                <div class="fw-bold mb-2">What was it?</div>
                                <field name="review_as" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                                <group>
                                    <field name="category_id" invisible="review_as != 'expense'"
                                           required="review_as == 'expense' and review_state == 'to_review'"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="vendor_id" invisible="review_as != 'vendor'"
                                           required="review_as == 'vendor' and review_state == 'to_review'"
                                           placeholder="Which vendor?" options="{'no_create': True}"
                                           context="{'res_partner_search_mode': 'supplier'}"/>
                                </group>
                                <div class="text-muted small" invisible="review_as != 'expense'">
                                    A cost of the business, booked on the category.</div>
                                <div class="text-muted small" invisible="review_as != 'vendor'">
                                    The owner paid a supplier: the amount goes on the vendor's account and is applied
                                    to his bills ("Add" under outstanding payments of the bill). His balance does not change.</div>
                            </div>
                            <group invisible="review_state == 'to_review'">
                                <field name="review_as" readonly="1"/>
                                <field name="category_id" readonly="1" invisible="not expense_id"/>
                                <field name="vendor_id" readonly="1" invisible="not vendor_id"/>
                                <field name="vendor_entry_id" invisible="not vendor_entry_id"/>
                                <field name="expense_id" invisible="not expense_id"/>
                            </group>
                        </div>
                        <div style="width: 340px; max-width: 100%;">
                            <field name="photo" widget="image" readonly="1" invisible="not photo"
                                   options="{'zoom': true, 'size': [340, 0]}"/>
                            <div class="text-muted border rounded-3 p-4 text-center" invisible="photo">
                                <i class="fa fa-camera fa-2x d-block mb-2" title="No photo"/>No photo
                            </div>
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"
                                   invisible="photo_count &lt; 2" class="mt-2"/>
                        </div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="photo_count" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ecc_owner_move_review" model="ir.actions.act_window">
        <field name="name">Owner Expenses to Review</field>
        <field name="res_model">ecc.owner.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ecc_owner_move_review_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_ecc_owner_move_review_form')})]"/>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to review</p>
            <p>What the owners paid. On each line: an expense (category) or a payment to a vendor, then Confirm.
               Reject what is not a business expense.</p>
        </field>
    </record>

