<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ecc_receipt_company" model="ir.rule">
        <field name="name">Telegram receipt: multi-company</field>
        <field name="model_id" ref="model_ecc_receipt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ecc_receipt_photo_company" model="ir.rule">
        <field name="name">Telegram receipt photo: multi-company</field>
        <field name="model_id" ref="model_ecc_receipt_photo"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ecc_telegram_sender_company" model="ir.rule">
        <field name="name">Telegram sender: multi-company</field>
        <field name="model_id" ref="model_ecc_telegram_sender"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
